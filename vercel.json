{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon.svg|manifest.webmanifest|push-sw.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/push-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/push-cron",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/push.ts": {
      "maxDuration": 60
    },
    "api/push-cron.ts": {
      "maxDuration": 60
    }
  }
}
